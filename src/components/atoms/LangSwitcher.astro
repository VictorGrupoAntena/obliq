---
interface Props {
  locale: string;
  /** Ruta equivalente en el otro idioma, o null si esta página no la tiene. */
  altPath?: string | null;
}

const { locale, altPath = null } = Astro.props;
const altLocale = locale === 'es' ? 'en' : 'es';

// Sin equivalente (páginas legales, solo en español) caemos a la home del otro
// idioma en vez de ocultar el control: el usuario sigue pudiendo cambiar de
// idioma y el header no cambia de forma entre páginas. Nunca se enlaza una
// ruta inventada.
const href = altPath ?? (altLocale === 'en' ? '/en/' : '/');
---

<a
  href={href}
  class="text-[12px] font-medium uppercase tracking-[3px] opacity-60 hover:opacity-100 transition-opacity"
  aria-label={locale === 'es' ? 'Switch to English' : 'Cambiar a Español'}
>
  {altLocale.toUpperCase()}
</a>
