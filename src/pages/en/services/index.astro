---
import BaseLayout from '@/layouts/BaseLayout.astro';
import HeroSection from '@/components/sections/HeroSection.astro';
import CTASection from '@/components/sections/CTASection.astro';
import ServiceCard from '@/components/cards/ServiceCard.astro';
import Button from '@/components/atoms/Button.astro';
import { t, localizedUrl } from '@/lib/i18n';
import { getServicesAsync } from '@/data/services';
import { getServicesPageAsync } from '@/data/services-page';

const locale = 'en';
const i18n = t(locale);
const services = await getServicesAsync();
// Textos de esta página desde WordPress, con fallback campo a campo a i18n.
const sp = await getServicesPageAsync(locale);
---

<BaseLayout
  title={i18n.SERVICES_PAGE.TITLE}
  seoTitle={sp.seoTitle}
  description={sp.seoDescription}
  locale={locale}
>
  <!-- Hero -->
  <HeroSection
    tag={sp.heroTag}
    title={sp.heroTitle}
    subtitle={sp.heroSubtitle}
    height="min-h-[50vh] md:min-h-[60vh]"
  />

  <!-- Services Grid -->
  <section class="bg-black py-section px-4 md:px-section">
    <div class="grid grid-cols-1 md:grid-cols-2 lg:grid-cols-3 gap-4">
      {services.map((svc) => {
        return (
          <ServiceCard
            title={svc.name.en}
            description={svc.shortDescription.en}
            image={svc.image}
            href={localizedUrl('/servicios/' + svc.slug.en + '/', locale)}
            ctaText={i18n.SERVICE_PAGE.VIEW_SERVICE}
          />
        );
      })}
    </div>
  </section>

  <!-- CTA -->
  <CTASection title={sp.ctaTitle} background="dark">
    <Button variant="primary" href={localizedUrl('/contacto/', locale)}>
      {sp.ctaButton}
    </Button>
  </CTASection>
</BaseLayout>

<script>
  import { initScrollFadeInAll } from '@/lib/gsap';

  function initServicesAnimations() {
    initScrollFadeInAll([
      ['.bg-black .grid > *', '.bg-black .grid', { stagger: 0.06 }],
    ]);
  }

  initServicesAnimations();
  document.addEventListener('astro:after-swap', initServicesAnimations);
</script>
