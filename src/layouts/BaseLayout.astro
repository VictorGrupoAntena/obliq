---
import '@/styles/global.css';
import '@fontsource-variable/montserrat';
import Header from '@/components/organisms/Header.astro';
import Footer from '@/components/organisms/Footer.astro';
import TransitionMask from '@/components/organisms/TransitionMask.astro';
import WhatsAppFAB from '@/components/organisms/WhatsAppFAB.astro';
import CartBottomBar from '@/components/organisms/CartBottomBar.astro';
import CookieConsent from '@/components/organisms/CookieConsent.astro';
import {
  GA_MEASUREMENT_ID,
  GA_COOKIE_NAMES,
  CONSENT_KEY,
  CONSENT_SCHEMA,
  CONSENT_MAX_AGE_MS,
} from '@/data/analytics';
import { getLocale } from '@/lib/i18n';
import { translatePath } from '@/lib/routes';
import { localBusinessSchema } from '@/lib/schema';
import { mapsLinkUrl } from '@/lib/maps';
import { getSiteContactAsync } from '@/data/site';
import { ClientRouter } from 'astro:transitions';

interface Props {
  title: string;
  description?: string;
  locale?: string;
  ogImage?: string;
  schema?: Record<string, unknown>;
  noindex?: boolean;
  pageColor?: 'black' | 'white';
}

const {
  title,
  description,
  locale: localeProp,
  ogImage = '/hero.jpg',
  schema,
  noindex = false,
  pageColor = 'black',
} = Astro.props;

const locale = localeProp ?? getLocale(Astro.url);
const contact = await getSiteContactAsync(locale);
const altLocale = locale === 'es' ? 'en' : 'es';
// null = esta página no tiene equivalente en el otro idioma (legales ES-only).
// En ese caso NO se emite alternate: es preferible el silencio a señalar un 404.
const altPath = await translatePath(Astro.url.pathname, locale);
const siteUrl = 'https://obliqproductions.com';
const canonicalUrl = siteUrl + Astro.url.pathname;
const fullTitle = title + ' | Obliq Productions';
const ogImageUrl = ogImage.startsWith('http') ? ogImage : siteUrl + ogImage;
---

<!doctype html>
<html lang={locale}>
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <link rel="icon" type="image/x-icon" href="/favicon.ico" />
    <meta name="generator" content={Astro.generator} />

    <title>{fullTitle}</title>
    {description && <meta name="description" content={description} />}
    {noindex && <meta name="robots" content="noindex, nofollow" />}

    <link rel="canonical" href={canonicalUrl} />
    {altPath && (
      <>
        <link rel="alternate" hreflang={locale} href={canonicalUrl} />
        <link rel="alternate" hreflang={altLocale} href={siteUrl + altPath} />
        <link rel="alternate" hreflang="x-default" href={siteUrl + (locale === 'es' ? Astro.url.pathname : altPath)} />
      </>
    )}

    <!-- Open Graph -->
    <meta property="og:type" content="website" />
    <meta property="og:title" content={fullTitle} />
    {description && <meta property="og:description" content={description} />}
    <meta property="og:image" content={ogImageUrl} />
    <meta property="og:url" content={canonicalUrl} />
    <meta property="og:locale" content={locale === 'es' ? 'es_ES' : 'en_US'} />
    <meta property="og:site_name" content="Obliq Productions" />

    <!-- Twitter Cards -->
    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:title" content={fullTitle} />
    {description && <meta name="twitter:description" content={description} />}
    <meta name="twitter:image" content={ogImageUrl} />

    <!-- ──────────────────────────────────────────────────────────────────
         Consent Mode v2 + Google Analytics.

         EL ORDEN DE ESTE BLOQUE ES EL REQUISITO, no un detalle de estilo:
           1. dataLayer + gtag()
           2. consent 'default' = denied — las CUATRO señales de la v2
           3. lectura SÍNCRONA de la decisión guardada
           4. solo si hay consentimiento vigente: consent 'update' + carga de
              gtag.js, inyectada desde aquí y no como etiqueta async estática.

         Antes la etiqueta async de gtag.js iba PRIMERO, delante de todo esto.
         Con Consent Mode eso es una carrera real: un script async puede
         ejecutarse en cuanto termina de descargar —desde caché, antes incluso
         de que el parser llegue al inline siguiente—, y entonces mediría antes
         del `consent default`. Por eso la librería ya no está en el marcado.

         (Y por eso este comentario no escribe ninguna etiqueta de script
         literal: dentro de un comentario HTML es inofensiva para el navegador,
         pero confunde a cualquier herramienta que analice el HTML por patrones
         —incluido scripts/check-consent.mjs, que busca justamente eso.)

         MODO BÁSICO: sin decisión NO sale una sola petición a Google. Para
         pasar a modo avanzado (pings cookieless, gcs=G100) bastaría con sacar
         loadGa() del if de apply(); el resto no cambia.

         NO METER AQUÍ NADA DEPENDIENTE DE LA PÁGINA —ni `locale`, ni la ruta—.
         Astro deduplica los scripts is:inline del <head> por su textContent y
         NO los reejecuta tras un swap de View Transitions. Si el contenido
         variara entre páginas, un swap ES→EN lo reejecutaría y empujaría un
         SEGUNDO `consent default` al dataLayer.
         ────────────────────────────────────────────────────────────────── -->
    <script
      is:inline
      define:vars={{
        GA_ID: GA_MEASUREMENT_ID,
        GA_COOKIES: GA_COOKIE_NAMES,
        KEY: CONSENT_KEY,
        SCHEMA: CONSENT_SCHEMA,
        MAX_AGE: CONSENT_MAX_AGE_MS,
      }}
    >
      window.dataLayer = window.dataLayer || [];
      function gtag() { dataLayer.push(arguments); }
      window.gtag = gtag;

      gtag('consent', 'default', {
        ad_storage: 'denied',
        ad_user_data: 'denied',
        ad_personalization: 'denied',
        analytics_storage: 'denied',
      });

      window.__obliqConsent = (function () {
        function read() {
          try {
            var raw = localStorage.getItem(KEY);
            if (!raw) return null;
            var d = JSON.parse(raw);
            if (!d || d.v !== SCHEMA || typeof d.ts !== 'number' || !d.categories) return null;
            if (Date.now() - d.ts > MAX_AGE) { localStorage.removeItem(KEY); return null; }
            return d;
          } catch (e) { return null; }
        }

        function loadGa() {
          if (window.__obliqGaLoaded) return;
          window.__obliqGaLoaded = true;
          var s = document.createElement('script');
          s.async = true;
          s.src = 'https://www.googletagmanager.com/gtag/js?id=' + GA_ID;
          document.head.appendChild(s);
          gtag('js', new Date());
          gtag('config', GA_ID);
        }

        // Revocar NO se resuelve con `consent update: denied`: eso impide que
        // gtag USE las cookies, pero no las borra. Una auditoría mira el
        // almacén de cookies del navegador, no el dataLayer. Se barren en cada
        // carga sin consentimiento y al revocar.
        function clearGaCookies() {
          var host = location.hostname;
          var parts = host.split('.');
          var domains = ['', host, '.' + host];
          if (parts.length > 2) domains.push('.' + parts.slice(-2).join('.'));
          for (var i = 0; i < GA_COOKIES.length; i++) {
            for (var j = 0; j < domains.length; j++) {
              document.cookie = GA_COOKIES[i] + '=; Max-Age=0; path=/'
                + (domains[j] ? '; domain=' + domains[j] : '');
            }
          }
        }

        function apply(d) {
          var granted = !!(d && d.categories && d.categories.analytics);
          gtag('consent', 'update', { analytics_storage: granted ? 'granted' : 'denied' });
          if (granted) loadGa(); else clearGaCookies();
        }

        function save(categories, action) {
          var d = { v: SCHEMA, ts: Date.now(), action: action, categories: categories };
          try { localStorage.setItem(KEY, JSON.stringify(d)); } catch (e) {}
          apply(d);
          document.documentElement.classList.remove('obliq-consent-pending');
          // Para los consumidores que NO viven aquí. `apply()` resuelve GA, que
          // se carga desde este mismo script; el mapa de /contacto/ no puede
          // —esto es global a las 76 páginas y no sabe en cuál está—, así que
          // se entera por el evento. Solo en save(): al arrancar, el componente
          // aún no ha bindeado nada y lee el estado con read() directamente.
          document.dispatchEvent(new CustomEvent('obliq:consent', { detail: d }));
          return d;
        }

        function clear() { try { localStorage.removeItem(KEY); } catch (e) {} }

        var stored = read();
        if (stored) {
          apply(stored);
        } else {
          // La marca se pone en <html> ANTES de que exista el <body>: el banner
          // se pinta ya visible o ya oculto en el primer frame. Sin parpadeo en
          // ninguna de las dos direcciones y sin depender de cuándo corra el
          // bundle del componente.
          document.documentElement.classList.add('obliq-consent-pending');
          clearGaCookies();
        }

        return { read: read, save: save, clear: clear };
      })();
    </script>

    <!-- Google Site Verification -->
    <meta name="google-site-verification" content="bcIGNgcRlmTeFWASR-elUipgGBy9_WO9lzsvy-Vbq4A" />

    <!-- Schema.org LocalBusiness -->
    <script type="application/ld+json" set:html={JSON.stringify(localBusinessSchema({
      telephone: contact.phoneTel,
      email: contact.email,
      streetAddress: contact.addressStreet,
      postalCode: contact.addressPostal,
      addressLocality: contact.addressCity,
      hasMap: mapsLinkUrl(contact.address),
    }))} />
    {schema && (
      <script type="application/ld+json" set:html={JSON.stringify(schema)} />
    )}

    <ClientRouter />
    <slot name="head" />
  </head>
  <body
    class:list={[
      'flex flex-col min-h-screen pt-16 md:pt-20',
      pageColor === 'white' ? 'bg-white text-black' : 'bg-black text-white',
    ]}
  >
    <a href="#main-content" class="sr-only focus:not-sr-only focus:absolute focus:top-4 focus:left-4 focus:z-[1000] focus:bg-white focus:text-black focus:px-4 focus:py-2">
      {locale === 'es' ? 'Ir al contenido principal' : 'Skip to main content'}
    </a>

    {/* Va aquí, justo tras el skip-link, a propósito: es `fixed`, así que el
        orden del DOM no cambia nada visualmente, pero coloca los tres botones
        como segunda parada del tabulador. Un aviso que hay que poder accionar
        no puede estar detrás de veinte enlaces de navegación. El apilado lo
        resuelve su z-[999], por encima del FAB de WhatsApp (z-[998]). */}
    <CookieConsent locale={locale} />

    <TransitionMask enterColor={pageColor} />
    <Header pageColor={pageColor} locale={locale} altPath={altPath} />

    <main id="main-content">
      <slot />
    </main>

    <Footer locale={locale} />
    <CartBottomBar locale={locale} />
    <WhatsAppFAB locale={locale} />

    <script>
      import gsap from 'gsap';

      function initTransitionMask() {
        const mask = document.getElementById('transition-mask') as HTMLDivElement;
        if (!mask) return;

        const reducedMotion = window.matchMedia('(prefers-reduced-motion: reduce)').matches;

        const hideMask = () => { mask.style.translate = '0 -100%'; };
        const showMask = () => { mask.style.translate = '0 0'; };

        const slideIn = (pageColor: string) =>
          new Promise<void>((resolve) => {
            if (reducedMotion) { showMask(); resolve(); return; }
            showMask();
            gsap.fromTo(mask,
              { opacity: 0 },
              {
                opacity: 1,
                duration: 0.4,
                ease: 'power2.inOut',
                onStart: () => mask.classList.remove('pointer-events-none'),
                onComplete: () => {
                  mask.style.backgroundColor = pageColor;
                  resolve();
                },
              },
            );
          });

        const slideOut = () => {
          if (reducedMotion) { hideMask(); return; }
          gsap.to(mask, {
            opacity: 0,
            duration: 0.4,
            ease: 'power2.inOut',
            onComplete: () => {
              hideMask();
              gsap.set(mask, { opacity: 1 });
              mask.classList.add('pointer-events-none');
            },
          });
        };

        document.querySelectorAll('a[href]').forEach((link) => {
          const anchor = link as HTMLAnchorElement;
          const url = new URL(anchor.href, location.origin);
          const isSameOrigin = location.origin === url.origin;
          const pageColor = anchor.dataset.pageColor || 'black';

          if (!isSameOrigin || anchor.target === '_blank') return;

          anchor.addEventListener('click', async (e) => {
            e.preventDefault();
            await slideIn(pageColor);
            window.location.href = anchor.href;
          });
        });

        if (location.pathname === '/' || location.pathname === '/en/') {
          hideMask();
          return;
        }
        slideOut();
      }

      initTransitionMask();
      document.addEventListener('astro:after-swap', initTransitionMask);
    </script>
  </body>
</html>
