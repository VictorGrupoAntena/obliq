# Config pública versionada — NO poner secretos aquí (esos van a .env.local).
#
# WordPress headless (lectura pública, sin auth). Con la variable definida el
# build SSG consume WP; si el fetch falla (dev offline) las facades de
# src/data/* caen automáticamente al mock con un console.warn.
# Para forzar mock en local: comentar la línea.
WP_API_URL=https://admin.obliqproductions.com/wp-json/wp/v2
